          "stringUnit": {
            "state": "translated",
            "value": "Mager rood vlees. Bron van eiwitten en ijzer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脂肪の少ない赤身肉。たんぱく質と鉄の供給源です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기름기 적은 붉은 고기예요. 단백질과 철분 공급원이에요."
