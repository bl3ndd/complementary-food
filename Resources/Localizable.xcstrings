    "Фрукт с высоким содержанием витамина C. Также источник клетчатки." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Frucht mit viel Vitamin C. Auch eine Quelle von Ballaststoffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fruit high in vitamin C. Also a source of fiber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fruta con mucha vitamina C. También fuente de fibra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fruit riche en vitamine C. Également source de fibres."
          }
