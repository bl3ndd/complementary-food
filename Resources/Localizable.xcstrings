    "Пометить аллергию? Напоминания по этому аллергену отключатся." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allergie vermerken? Erinnerungen für dieses Allergen werden deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark as allergy? Reminders for this allergen will turn off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Marcar como alergia? Los recordatorios de este alérgeno se desactivarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquer comme allergie ? Les rappels pour cet allergène seront désactivés."
