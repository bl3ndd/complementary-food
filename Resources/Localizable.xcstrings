            "value" : "Vanaf welke leeftijd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od jakiego wieku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de que idade"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi yaştan itibaren"
          }
        },
        "uk" : {
