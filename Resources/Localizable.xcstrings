          "stringUnit": {
            "state": "translated",
            "value": "Une viande rouge maigre. Source de protéines et de fer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carne roja magra. Fuente de proteína y hierro."
          }
        },
