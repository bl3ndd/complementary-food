    "Плод с высоким содержанием жиров. Источник полезных жиров, калия и витамина E.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A high-fat fruit. Source of healthy fats, potassium and vitamin E."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine fettreiche Frucht. Quelle von gesunden Fetten, Kalium und Vitamin E."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fruit riche en graisses. Source de bonnes graisses, de potassium et de vitamine E."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fruta con muchas grasas. Fuente de grasas saludables, potasio y vitamina E."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un frutto ricco di grassi. Fonte di grassi buoni, potassio e vitamina E."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruta rica em gorduras. Fonte de gorduras boas, potássio e vitamina E."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Owoc o dużej zawartości tłuszczu. Źródło zdrowych tłuszczów, potasu i witaminy E."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağ oranı yüksek bir meyve. Sağlıklı yağlar, potasyum ve E vitamini kaynağı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плід із високим вмістом жирів. Джерело корисних жирів, калію та вітаміну E."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vetrijke vrucht. Bron van gezonde vetten, kalium en vitamine E."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脂質が豊富な果物。良質な脂質・カリウム・ビタミンEの供給源です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지방이 많은 과일이에요. 좋은 지방, 칼륨, 비타민 E 공급원이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高脂水果，富含健康脂肪、钾和维生素E。"
          }
        }
      }
    },
