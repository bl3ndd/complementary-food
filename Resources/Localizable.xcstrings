    "Кисломолочный напиток. Источник кальция, белка и пробиотиков." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Sauermilchgetränk. Quelle von Kalzium, Eiweiß und Probiotika."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cultured milk drink. Source of calcium, protein and probiotics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bebida láctea fermentada. Fuente de calcio, proteína y probióticos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une boisson lactée fermentée. Source de calcium, de protéines et de probiotiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bevanda a base di latte fermentato. Fonte di calcio, proteine e probiotici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発酵乳飲料。カルシウム・たんぱく質・プロバイオティクスの供給源です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발효유 음료예요. 칼슘, 단백질, 프로바이오틱스 공급원이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gefermenteerde melkdrank. Bron van calcium, eiwitten en probiotica."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napój fermentowany mleczny. Źródło wapnia, białka i probiotyków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebida láctea fermentada. Fonte de cálcio, proteína e probióticos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermente bir süt içeceği. Kalsiyum, protein ve probiyotik kaynağı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кисломолочний напій. Джерело кальцію, білка та пробіотиків."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发酵奶饮品，富含钙、蛋白质和益生菌。"
          }
        }
      }
    },
