    "Отметь продукты, которые малыш уже пробовал без проблем. Можно пропустить." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Lebensmittel, die dein Baby schon problemlos probiert hat. Du kannst das überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark foods your baby has already tried without issues. You can skip this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca los alimentos que tu bebé ya ha probado sin problemas. Puedes saltarte esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coche les aliments que ton bébé a déjà goûtés sans souci. Tu peux passer."
