    "Каждый введённый продукт появится здесь — начни с первого!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every introduced food will appear here — start with the first one!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes eingeführte Lebensmittel erscheint hier – fang mit dem ersten an!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque aliment introduit apparaîtra ici — commence par le premier !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada alimento introducido aparecerá aquí: ¡empieza con el primero!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni alimento introdotto comparirà qui — inizia dal primo!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada alimento introduzido vai aparecer aqui — comece pelo primeiro!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wprowadzony produkt pojawi się tutaj — zacznij od pierwszego!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıtılan her besin burada görünecek — ilkinden başla!"
