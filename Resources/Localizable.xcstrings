    "Постное красное мясо. Источник белка и железа.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean red meat. Source of protein and iron."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mageres rotes Fleisch. Quelle von Eiweiß und Eisen."
          }
        },
