    "По выбранной методике прикорм лучше начинать ~%@ мес.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan suggests starting solids around %@ mo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der gewählten Methode startest du die Beikost am besten mit ~%@ Mon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon ta méthode, il vaut mieux commencer la diversification vers %@ mois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el método elegido, es mejor empezar la alimentación complementaria hacia los %@ meses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il metodo scelto è meglio iniziare lo svezzamento intorno ai %@ mesi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo método escolhido, o ideal é começar a introdução alimentar por volta de %@ meses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Według wybranej metody rozszerzanie diety najlepiej zacząć ~%@ mies."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen yönteme göre ek gıdaya ~%@ ayken başlamak en iyisi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За вибраною методикою прикорм краще починати ~%@ міс."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgens de gekozen methode kun je het beste rond %@ mnd met eerste hapjes beginnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ進め方では、離乳食の開始は%@か月ごろがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 방법으로는 이유식을 %@개월쯤 시작하면 좋아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按所选方法，辅食最好在约%@个月时开始。"
          }
        }
      }
    },
