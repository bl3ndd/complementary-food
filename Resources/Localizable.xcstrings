    "Выбери готовую или собери свой план. Можно сменить позже." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl eine fertige Methode oder stell deinen eigenen Plan zusammen. Du kannst es später ändern."
          }
        },
        "en" : {
