        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재료를 계속 진행하세요 — %2$lld회 중 %1$lld회 기록됨. 반응을 살펴보세요 👀"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga door met introduceren — %1$lld van %2$lld voedingen vastgelegd. Let op reacties 👀"
