    "Сначала выгрузите данные (Данные → Дневник для педиатра) — после сброса восстановить нельзя.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export first (Data → Diary for pediatrician) — after reset there’s no recovery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere zuerst deine Daten (Daten → Tagebuch für den Kinderarzt) – nach dem Zurücksetzen gibt es keine Wiederherstellung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte d'abord tes données (Données → Journal pour le pédiatre) — après la réinitialisation, aucune récupération n'est possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta primero (Datos → Diario para el pediatra): tras el restablecimiento no hay recuperación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta prima i dati (Dati → Diario per il pediatra) — dopo il reset non c'è modo di recuperarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro exporte os dados (Dados → Diário para o pediatra) — depois de apagar, não dá para recuperar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wyeksportuj dane (Dane → Dzienniczek dla pediatry) — po resecie nie da się ich przywrócić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce verileri dışa aktar (Veriler → Çocuk doktoru için günlük) — sıfırladıktan sonra geri getiremezsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку вивантаж дані (Дані → Щоденник для педіатра) — після скидання відновити не можна."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer eerst je gegevens (Gegevens → Dagboek voor de kinderarts) — na het resetten is herstel niet meer mogelijk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にデータを書き出してください（データ → 小児科医向けの日記）。リセット後は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 데이터를 내보내요 (데이터 → 소아과용 일기) — 초기화 후에는 복구할 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先导出数据（数据 → 给儿科医生的日记）——重置后无法恢复。"
          }
        }
      }
    },
