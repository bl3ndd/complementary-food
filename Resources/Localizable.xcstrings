    "Здесь будет история кормлений. Записывай продукты — и дневник наполнится.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feeding history will live here. Log foods and the diary fills up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier entsteht deine Fütterungshistorie. Trag Lebensmittel ein – und das Tagebuch füllt sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton historique de repas apparaîtra ici. Enregistre des aliments et le journal se remplira."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí estará tu historial de tomas. Registra alimentos y el diario se irá llenando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vivrà la cronologia dei pasti. Registra gli alimenti e il diario si riempirà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de refeições vai ficar aqui. Registre os alimentos e o diário vai enchendo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj będzie historia karmień. Zapisuj produkty — a dzienniczek się zapełni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
