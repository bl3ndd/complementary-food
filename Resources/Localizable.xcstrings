    "Пометим как аллерген и будем осторожнее при вводе." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir markieren es als Allergen und sind bei der Einführung vorsichtiger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll mark it as an allergen and be more careful introducing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo marcaremos como alérgeno y tendremos más cuidado al introducirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On le marquera comme allergène et on sera plus prudent à l'introduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo segneremo come allergene e faremo più attenzione durante l'introduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アレルゲンとして記録し、導入をより慎重に進めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알레르겐으로 표시하고 도입할 때 더 조심할게요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We markeren het als allergeen en zijn voorzichtiger bij de introductie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczymy jako alergen i będziemy ostrożniejsi przy wprowadzaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos marcar como alérgeno e ter mais cuidado na introdução."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu alerjen olarak işaretleyeceğiz ve tanıtırken daha dikkatli olacağız."
