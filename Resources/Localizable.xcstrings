    "Продолжай вводить продукт — записано %lld из %lld кормлений. Следи за реакцией 👀" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe das Lebensmittel weiter ein – %1$lld von %2$lld Mahlzeiten erfasst. Achte auf Reaktionen 👀"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep introducing the food — %1$lld of %2$lld feedings logged. Watch for reactions 👀"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue introduciendo el alimento: %1$lld de %2$lld tomas registradas. Atenta a las reacciones 👀"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue d'introduire l'aliment — %1$lld repas sur %2$lld enregistrés. Surveille les réactions 👀"
