    "Желток яйца. Источник холина, витамина D, железа и белка.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Egg yolk. Source of choline, vitamin D, iron and protein."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigelb. Quelle von Cholin, Vitamin D, Eisen und Eiweiß."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaune d'œuf. Source de choline, de vitamine D, de fer et de protéines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yema de huevo. Fuente de colina, vitamina D, hierro y proteína."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuorlo d'uovo. Fonte di colina, vitamina D, ferro e proteine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gema de ovo. Fonte de colina, vitamina D, ferro e proteína."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żółtko jaja. Źródło choliny, witaminy D, żelaza i białka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumurta sarısı. Kolin, D vitamini, demir ve protein kaynağı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жовток яйця. Джерело холіну, вітаміну D, заліза та білка."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigeel. Bron van choline, vitamine D, ijzer en eiwitten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "卵の黄身。コリン・ビタミンD・鉄・たんぱく質の供給源です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달걀 노른자예요. 콜린, 비타민 D, 철분, 단백질 공급원이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蛋黄，富含胆碱、维生素D、铁和蛋白质。"
          }
        }
      }
    },
