    "Не выбран ни один аллерген — трекер поддержки работать не будет.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No allergen selected — the maintenance tracker won’t work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Allergen ausgewählt – der Erhaltungs-Tracker funktioniert so nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun allergène sélectionné — le suivi d'entretien ne fonctionnera pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún alérgeno seleccionado: el seguimiento de mantenimiento no funcionará."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun allergene selezionato — il tracker di mantenimento non funzionerà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum alérgeno selecionado — o rastreador de manutenção não vai funcionar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano żadnego alergenu — tracker podtrzymania nie będzie działać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç alerjen seçilmedi — koruma takibi çalışmayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вибрано жодного алергену — трекер підтримки не працюватиме."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel allergeen geselecteerd — de onderhoudstracker werkt niet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アレルゲンが1つも選ばれていないため、維持トラッカーは動作しません。"
