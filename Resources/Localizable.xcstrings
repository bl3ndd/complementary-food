    "Дневник прикорма без паники: что вводить, когда и не забыть про аллергены." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beikost-Tagebuch ohne Panik: was du wann einführst – und kein Allergen vergisst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stress-free feeding diary: what to introduce, when, and never forget the allergens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un diario de alimentación complementaria sin agobios: qué introducir, cuándo y sin olvidar los alérgenos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un journal de diversification sans stress : quoi introduire, quand, et sans oublier les allergènes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un diario dello svezzamento senza stress: cosa introdurre, quando e senza mai dimenticare gli allergeni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あわてない離乳食日記。何をいつ導入するか、アレルゲンのことも忘れずに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당황하지 않는 이유식 일기: 무엇을 언제 도입하고 알레르겐도 잊지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stressvrij dagboek voor eerste hapjes: wat je introduceert, wanneer, en vergeet de allergenen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzienniczek rozszerzania diety bez paniki: co wprowadzać, kiedy i jak nie zapomnieć o alergenach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diário de introdução alimentar sem pânico: o que introduzir, quando, e sem esquecer dos alérgenos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paniksiz ek gıda günlüğü: neyi ne zaman tanıtacağını bil, alerjenleri de unutma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
