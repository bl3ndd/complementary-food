    "Дневник для педиатра появится после первой записи кормления.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pediatrician diary unlocks after your first feeding entry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tagebuch für den Kinderarzt erscheint nach dem ersten Fütterungseintrag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal pour le pédiatre apparaîtra après ta première entrée de repas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario para el pediatra se desbloquea tras tu primer registro de toma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il diario per il pediatra si sblocca dopo la prima voce di pasto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diário para o pediatra aparece depois do primeiro registro de refeição."
          }
        },
