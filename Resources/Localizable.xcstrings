        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування підтримують введені алергени — без них трекер не спрацює."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen houden geïntroduceerde allergenen op peil — zonder herinneringen werkt de tracker niet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーが導入済みのアレルゲンを支えます。オフだとトラッカーは働きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 도입한 알레르겐을 유지해 줘요 — 알림이 없으면 트래커가 작동하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒帮你维持已引入的过敏原——没有它追踪器就不会工作。"
          }
        }
      }
    },
    "Напомним попробовать снова %@": {
      "localizations": {
        "en": {
