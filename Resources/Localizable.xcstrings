    "Овощ с высоким содержанием витамина C. Также источник бета-каротина.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vegetable high in vitamin C. Also a source of beta-carotene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gemüse mit viel Vitamin C. Auch eine Quelle von Beta-Carotin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un légume riche en vitamine C. Également source de bêta-carotène."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una verdura con mucha vitamina C. También fuente de betacaroteno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ortaggio ricco di vitamina C. Anche fonte di beta-carotene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetal rico em vitamina C. Também fonte de betacaroteno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warzywo o dużej zawartości witaminy C. Także źródło beta-karotenu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "C vitamini oranı yüksek bir sebze. Aynı zamanda beta-karoten kaynağı."
