    "Напоминания держат введённые аллергены под контролем — без них трекер не сработает. Язык применяется после перезапуска.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders keep introduced allergens on track — without them the tracker won’t fire. Language applies after a restart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen halten eingeführte Allergene unter Kontrolle – ohne sie funktioniert der Tracker nicht. Die Sprache gilt nach einem Neustart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels gardent les allergènes introduits sous contrôle — sans eux, le suivi ne fonctionne pas. La langue s'applique après un redémarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios mantienen los alérgenos introducidos bajo control: sin ellos el seguimiento no funcionará. El idioma se aplica tras reiniciar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria tengono sotto controllo gli allergeni introdotti — senza di essi il tracker non funziona. La lingua si applica dopo il riavvio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes mantêm os alérgenos introduzidos sob controle — sem eles, o rastreador não funciona. O idioma é aplicado depois de reiniciar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia utrzymują wprowadzone alergeny pod kontrolą — bez nich tracker nie zadziała. Język zostanie zastosowany po ponownym uruchomieniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılar tanıtılan alerjenleri kontrol altında tutar — onlar olmadan takip özelliği çalışmaz. Dil, yeniden başlatınca uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування тримають введені алергени під контролем — без них трекер не спрацює. Мова застосовується після перезапуску."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen houden geïntroduceerde allergenen onder controle — zonder herinneringen werkt de tracker niet. De taal wordt toegepast na een herstart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーが導入済みのアレルゲンを管理します。オフだとトラッカーは働きません。言語は再起動後に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 도입한 알레르겐을 잘 챙겨 줘요 — 알림이 없으면 트래커가 작동하지 않아요. 언어는 재시작 후에 적용돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒能帮你把已引入的过敏原管理好——没有它追踪器就不会触发。语言会在重启后生效。"
          }
        }
      }
    },
    "Напоминания по этому аллергену отключатся.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders for this allergen will turn off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen für dieses Allergen werden deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels pour cet allergène seront désactivés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de este alérgeno se desactivarán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria per questo allergene verranno disattivati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes deste alérgeno serão desativados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia dla tego alergenu zostaną wyłączone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alerjenin hatırlatıcıları kapanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування щодо цього алергену вимкнуться."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen voor dit allergeen worden uitgeschakeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアレルゲンのリマインダーはオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알레르겐에 대한 알림이 꺼져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个过敏原的提醒会关闭。"
          }
        }
      }
    },
    "Напоминания поддерживают введённые аллергены — без них трекер не сработает.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
