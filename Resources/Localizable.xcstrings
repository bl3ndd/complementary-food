          "stringUnit": {
            "state": "translated",
            "value": "Carne rossa magra. Fonte di proteine e ferro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carne vermelha magra. Fonte de proteína e ferro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chude czerwone mięso. Źródło białka i żelaza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağsız kırmızı et. Protein ve demir kaynağı."
          }
