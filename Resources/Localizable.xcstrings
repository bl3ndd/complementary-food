    "Фрукт с высоким содержанием витамина C. Также источник клетчатки.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fruit high in vitamin C. Also a source of fiber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Frucht mit viel Vitamin C. Auch eine Quelle von Ballaststoffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fruit riche en vitamine C. Également source de fibres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fruta con mucha vitamina C. También fuente de fibra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un frutto ricco di vitamina C. Anche fonte di fibre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruta rica em vitamina C. Também fonte de fibras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Owoc o dużej zawartości witaminy C. Także źródło błonnika."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "C vitamini oranı yüksek bir meyve. Aynı zamanda lif kaynağı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрукт із високим вмістом вітаміну C. Також джерело клітковини."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vrucht met veel vitamine C. Ook een bron van vezels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビタミンCが豊富な果物。食物繊維の供給源でもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비타민 C가 풍부한 과일이에요. 식이섬유 공급원이기도 해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维生素C含量高的水果，也富含膳食纤维。"
          }
        }
      }
    },
