    "Настрой старт, окна наблюдения и аллергены. Можно изменить позже.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the start age, observation windows and allergens. You can change this later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell Start, Beobachtungsfenster und Allergene ein. Du kannst es später ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le début, les fenêtres d'observation et les allergènes. Tu pourras changer plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el inicio, las ventanas de observación y los alérgenos. Puedes cambiarlo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'inizio, le finestre di osservazione e gli allergeni. Puoi cambiarli dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o início, as janelas de observação e os alérgenos. Dá para mudar depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw wiek startu, okna obserwacji i alergeny. Możesz to później zmienić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıcı, gözlem pencerelerini ve alerjenleri ayarla. Sonra değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуй старт, вікна спостереження й алергени. Можна змінити пізніше."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de startleeftijd, observatievensters en allergenen in. Je kunt dit later wijzigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時期・観察期間・アレルゲンを設定しましょう。あとで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시기, 관찰 기간, 알레르겐을 설정해요. 나중에 바꿀 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置开始月龄、观察期和过敏原。之后随时能改。"
          }
        }
      }
    },
