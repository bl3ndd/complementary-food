    "Окно наблюдения прошло. Если реакции не было — отметь «ввёл успешно».": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The observation window is over. If there was no reaction, mark it as introduced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Beobachtungsfenster ist vorbei. Wenn es keine Reaktion gab, markiere „erfolgreich eingeführt“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre d'observation est terminée. S'il n'y a pas eu de réaction, marque-le comme introduit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana de observación terminó. Si no hubo reacción, márcalo como introducido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra di osservazione è finita. Se non ci sono state reazioni, segnalo come introdotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela de observação terminou. Se não houve reação, marque “introduzido com sucesso”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno obserwacji minęło. Jeśli nie było reakcji — oznacz „wprowadzono pomyślnie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlem penceresi sona erdi. Reaksiyon olmadıysa “başarıyla tanıtıldı” olarak işaretle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно спостереження минуло. Якщо реакції не було — познач «успішно введено»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het observatievenster is voorbij. Als er geen reactie was, markeer het als geïntroduceerd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観察期間が終わりました。反応がなければ「導入できました」を押しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관찰 기간이 끝났어요. 반응이 없었으면 「도입 성공」으로 표시해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察期结束了。如果没有反应，就标记为“成功引入”吧。"
          }
        }
      }
    },
