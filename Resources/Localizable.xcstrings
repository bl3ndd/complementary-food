    "Выбери готовую или собери свой план. Можно сменить позже.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a ready-made one or build your own. You can change it later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl eine fertige Methode oder stell deinen eigenen Plan zusammen. Du kannst es später ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un plan tout prêt ou compose le tien. Tu pourras le changer plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno predefinido o arma el tuyo. Puedes cambiarlo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline uno pronto o crea il tuo piano. Puoi cambiarlo dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um plano pronto ou monte o seu. Dá para mudar depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz gotowy lub stwórz własny plan. Możesz go później zmienić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır bir plan seç ya da kendi planını oluştur. Sonra değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери готову або збери свій план. Можна змінити пізніше."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een kant-en-klaar plan of stel je eigen plan samen. Je kunt het later wijzigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既製のプランを選ぶか、自分のプランを作りましょう。あとで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 것을 고르거나 나만의 계획을 만들어요. 나중에 바꿀 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个现成的，或搭建自己的方案。之后随时能改。"
          }
        }
      }
    },
