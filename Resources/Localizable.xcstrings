    "Список «не давать» соберётся из продуктов на паузе или с аллергией.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “do not give” list builds from foods that are paused or marked allergic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die „Nicht geben“-Liste entsteht aus pausierten Lebensmitteln und solchen mit Allergie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste « ne pas donner » se compose des aliments en pause ou marqués comme allergiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de «no dar» se forma con los alimentos en pausa o marcados como alergia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco \"da non dare\" si compone dagli alimenti in pausa o segnalati come allergie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista “não dar” é montada com os alimentos em pausa ou com alergia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista „nie podawać” utworzy się z produktów wstrzymanych lub oznaczonych jako alergia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Verilmeyecekler” listesi, duraklatılan veya alerji işaretli besinlerden oluşur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список «не давати» збереться з продуктів на паузі або з алергією."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De “niet geven”-lijst wordt samengesteld uit producten die gepauzeerd of als allergie gemarkeerd zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あげない」リストは、お休み中またはアレルギーの食材から自動で作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「주지 마세요」 목록은 멈춤 상태이거나 알레르기로 표시된 식품으로 채워져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“禁喂”清单会由暂停或标记过敏的食物自动汇总。"
          }
        }
      }
    },
