    "Наблюдай за реакцией. Кнопка «ввёл успешно» появится после %lld дн." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachte die Reaktion. Der Button „erfolgreich eingeführt“ erscheint nach %lld Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch for a reaction. The introduced button will appear after %lld days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila la reacción. El botón «introducido con éxito» aparecerá tras %lld días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveille la réaction. Le bouton « introduit avec succès » apparaîtra après %lld jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osserva la reazione. Il pulsante \"introdotto\" comparirà dopo %lld giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反応を見守りましょう。「導入できました」ボタンは%lld日後に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반응을 지켜봐요. 「도입 성공」 버튼은 %lld일 뒤에 나타나요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de reactie in de gaten. De knop “succesvol geïntroduceerd” verschijnt na %lld dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwuj reakcję. Przycisk „wprowadzono pomyślnie” pojawi się po %lld dniach."
          }
        },
