    "Плод с высоким содержанием жиров. Источник полезных жиров, калия и витамина E." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine fettreiche Frucht. Quelle von gesunden Fetten, Kalium und Vitamin E."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A high-fat fruit. Source of healthy fats, potassium and vitamin E."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fruta con muchas grasas. Fuente de grasas saludables, potasio y vitamina E."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fruit riche en graisses. Source de bonnes graisses, de potassium et de vitamine E."
