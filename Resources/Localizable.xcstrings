    "Отметь продукты, которые малыш уже пробовал без проблем. Можно пропустить.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark foods your baby has already tried without issues. You can skip this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Lebensmittel, die dein Baby schon problemlos probiert hat. Du kannst das überspringen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche les aliments que ton bébé a déjà goûtés sans souci. Tu peux passer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca los alimentos que tu bebé ya ha probado sin problemas. Puedes saltarte esto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna gli alimenti che il tuo bimbo ha già provato senza problemi. Puoi saltare questo passaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque os alimentos que o bebê já provou sem problemas. Pode pular."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz produkty, które maluszek już próbował bez problemów. Możesz to pominąć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebeğin sorunsuz denediği besinleri işaretle. Bu adımı atlayabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Познач продукти, які малюк уже пробував без проблем. Можна пропустити."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer de producten die je baby al zonder problemen heeft geproefd. Je kunt dit overslaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんが問題なく食べられた食材にチェックしましょう。スキップもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기가 문제없이 먹어 본 식품을 표시해요. 건너뛸 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标出宝宝已经试过、没问题的食物。可以跳过。"
          }
        }
      }
    },
