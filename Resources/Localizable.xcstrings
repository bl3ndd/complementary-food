    "Сколько дней наблюдать за реакцией на новый обычный продукт, прежде чем считать его введённым.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days to watch for a reaction to a new regular food before counting it as introduced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tage du bei einem neuen normalen Lebensmittel auf Reaktionen achtest, bevor es als eingeführt gilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de jours surveiller la réaction à un nouvel aliment ordinaire avant de le considérer comme introduit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos días vigilar la reacción a un nuevo alimento normal antes de contarlo como introducido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanti giorni osservare la reazione a un nuovo alimento normale prima di considerarlo introdotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos dias observar a reação a um novo alimento comum antes de considerá-lo introduzido."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile dni obserwować reakcję na nowy zwykły produkt, zanim uznasz go za wprowadzony."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir normal besine reaksiyonu, tanıtılmış saymadan önce kaç gün gözlemlemeli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки днів спостерігати за реакцією на новий звичайний продукт, перш ніж вважати його введеним."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel dagen je op een reactie op een nieuw gewoon product let voordat je het als geïntroduceerd beschouwt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい通常の食材を導入済みとみなすまでに、反応を何日間観察するかの設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 일반 식품을 도입 완료로 보기 전에 반응을 며칠 지켜볼지예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在算作已引入之前，要观察一种新的普通食物多少天。"
          }
        }
      }
    },
