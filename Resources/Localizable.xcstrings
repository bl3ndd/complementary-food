    "Растительное масло. Источник мононенасыщенных жиров и витамина E.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vegetable oil. Source of monounsaturated fats and vitamin E."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Pflanzenöl. Quelle von einfach ungesättigten Fetten und Vitamin E."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une huile végétale. Source de graisses mono-insaturées et de vitamine E."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aceite vegetal. Fuente de grasas monoinsaturadas y vitamina E."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un olio vegetale. Fonte di grassi monoinsaturi e vitamina E."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Óleo vegetal. Fonte de gorduras monoinsaturadas e vitamina E."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Olej roślinny. Źródło tłuszczów jednonienasyconych i witaminy E."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkisel yağ. Tekli doymamış yağlar ve E vitamini kaynağı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослинна олія. Джерело мононенасичених жирів і вітаміну E."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een plantaardige olie. Bron van enkelvoudig onverzadigde vetten en vitamine E."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物油。一価不飽和脂肪酸とビタミンEの供給源です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물성 기름이에요. 단일불포화지방과 비타민 E 공급원이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "植物油，富含单不饱和脂肪和维生素E。"
          }
        }
      }
    },
